# ==============================================================================
# NAPAS PRODUCTION & VERCEL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Masukkan variabel ini di Vercel Dashboard -> Project Settings -> Environment Variables

# 1. Frontend (Arsitektur Satu Pintu: Request diarahkan ke API)
VITE_SUPABASE_URL=https://enzizvrvfogjjgctpmli.supabase.co
# VITE_SUPABASE_ANON_KEY (Kunci publik anon dari Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# 2. Supabase Backend Server (Eksklusif Backend: Kunci service_role rahasia)
SUPABASE_URL=https://enzizvrvfogjjgctpmli.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# 3. Backend API URL
# Di Vercel production: kosongkan agar otomatis menggunakan Same-Origin Serverless Rewrites
# Di lokal development: http://127.0.0.1:8000
VITE_API_URL=
